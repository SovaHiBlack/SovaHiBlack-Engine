[m_tushkano_e]:monster_base
GroupControlSection					= spawn_group
SpaceRestrictionSection				= space_restrictor,zone_mosquito_bald
$spawn								= "monsters\old\tushkano"				; option for Level Editor
$npc								= on									; option for Level Editor
$prefetch							= 16

visual								= monsters\tushkano\tushkano
corpse_visual						= monsters\tushkano\tushkano_dead
icon								= ui_npc_monster_tushkano

species								= tushkano
rank								= 0
spec_rank							= weak
community							= tushkano

ef_creature_type					= 2					; option for evaluation functions
ef_weapon_type						= 2
ef_detector_type					= 1
panic_threshold						= 0.0

cform								= skeleton			; collision class
class								= SM_TUSHK ;AI_TUSH	; AI class

script_binding  	 = bind_monster.bind

bone_torso			 = bip01_spine1 			; bone name
bone_head			 = bip01_head				; bone name
bone_fire			 = bip01_head				; bone name
weapon_usage		 = 0						; boolean

terrain				 = tushkan_terrain

;------------------------------------------------------------------------------
; Offline Alife
;------------------------------------------------------------------------------
Scheduled							= on				; option for ALife Simulator
Human								= off				; option for ALife Simulator
Health								= 20				; option for ALife Simulator
MinSpeed							= 1.0				; option for ALife Simulator
MaxSpeed							= 5.0				; option for ALife Simulator
going_speed							= 5.0				; option for ALife Simulator
current_level_going_speed			= 1.0				; option for ALife Simulator
search_speed						= 1.5				; option for ALife Simulator

MaxHealthValue						= 20				; range [0..200]

smart_terrain_choose_interval		= 00:15:00

;------------------------------------------------------------------------------
; Physics
;------------------------------------------------------------------------------
ph_box0_center 		 = 0.0,  0.9,  0.0
ph_box0_size 		 = 0.35, 0.9,  0.35
ph_box1_center 		 = 0.0,  0.6,  0.0
ph_box1_size 		 = 0.40, 0.6,  0.40
ph_crash_speed_min			= 10
ph_crash_speed_max			= 30
ph_mass 		     = 20
ph_collision_damage_factor	= 0.1

destroyed_vis_name	 = physics\dead_body\skelet_crash_monster

ph_skeleton_airr_lin_factor   = -0.4
ph_skeleton_airr_ang_factor   = -0.2
ph_skeleton_hinger_factor1    = 1.0
ph_skeleton_ddelay            = 5.0
ph_skel_fatal_impulse_factor  = 2.0
ph_after_death_velocity_factor= 0.75
ph_skel_shot_up_factor        = 0.25

;------------------------------------------------------------------------------
; Movement::Velocities & Acceleration
;------------------------------------------------------------------------------
; speed factors				linear | angular_real | angular_path | min   |  max
Velocity_Stand			= 0,		3.5,			3.5,		1,		1
Velocity_WalkFwdNormal	= 1.0,		7.5,			7.5,		0.02,	1.8	
Velocity_RunFwdNormal	= 5.0,		3.5,			3.5,		0.3,	1	
Velocity_WalkFwdDamaged	= 1.0,		4.5,			4.5,		0.2,	1.8	
Velocity_RunFwdDamaged	= 3.0,  	3.0,			3.0,		0.5,	1
Velocity_Drag			= 1.0,		3.0,			3.0,		1,		1
Velocity_Steal			= 1.5,		3.0,			3.0,		1,		1

; acceleration
Accel_Generic			= 1.5
Accel_Calm				= 2.5
Accel_Aggressive		= 7.5

;------------------------------------------------------------------------------
; Attack parameters
;------------------------------------------------------------------------------
MinAttackDist					= 1.2
MaxAttackDist					= 1.8
as_min_dist						= 0.25
as_step							= 0.25

hit_type						= wound
hit_power						= 1

attack_params					= m_tushkano_attack_params
attack_effector					= small_monster_attack_effector

;------------------------------------------------------------------------------
; Entity Conditions
;------------------------------------------------------------------------------
satiety_v						= 0.00001				;скорость уменьшения сытости со временем [0...1]
satiety_power_v					= 0.005					;увеличение силы при уменьшении сытости [0...1]
satiety_health_v				= 0.0001				;увеличение здоровья при уменьшении сытости [0...1]
radiation_v						= 0.00001				;скорость уменьшения радиации [0...1]
radiation_health_v				= 0.01					;уменьшение здоровья при воздействии радиации [0...1]
morale_v						= 0.01					;скорость восстановления морали [0...1]
psy_health_v					= 0.1					;скорость восстановления psy-здоровья
bleeding_v						= 0.04					;потеря крови при номинальной ране в секунду
wound_incarnation_v				= 0.05					;крутизна кривой заживления (какой процент раны заживет в игровую секунду)
min_wound_size					= 0.01					;минимальный размер раны, после которого она считается зажившей
health_hit_part					= 1.0					;процент хита, уходящий на отнимание здоровья [0...1]
power_hit_part					= 1.0					;процент хита, уходящий на отнимание силы [0...1]

immunities_sect					= tushkano_immunities

;------------------------------------------------------------------------------
; Eat settings
;------------------------------------------------------------------------------
eat_freq						= 5.0					;частота укусов в сек
eat_slice						= 0.01					;увеличение сытости при 1 укусе
eat_slice_weight				= 10.0					;уменьшение еды у трупа

distance_to_corpse				= 1.2					;дистанция до трупа, при которой он переходит в состояние еды

;------------------------------------------------------------------------------
; Morale
;------------------------------------------------------------------------------
Morale_Hit_Quant				= 0.1
Morale_Attack_Success_Quant		= 0.1
Morale_Take_Heart_Speed			= 0.1
Morale_Despondent_Speed			= 0.1
Morale_Stable_Speed				= 0.05
Morale_Despondent_Threashold	= 0.5

;------------------------------------------------------------------------------
; Sounds and sound parameters
;------------------------------------------------------------------------------
sound_idle						= monsters\tushkano\tushkano_idle_
sound_distant_idle				= monsters\tushkano\tushkano_idle_
sound_eat						= monsters\tushkano\tushkano_eat_
sound_aggressive				= monsters\tushkano\tushkano_aggressive_
sound_attack_hit				= monsters\tushkano\tushkano_attack_
sound_take_damage				= monsters\tushkano\tushkano_pain_
sound_die						= monsters\tushkano\tushkano_death_
sound_die_in_anomaly			= monsters\tushkano\tushkano_anomaly_
sound_threaten					= monsters\tushkano\tushkano_threaten_
sound_steal						= monsters\tushkano\tushkano_idle_
sound_panic						= monsters\tushkano\tushkano_panic_

killer_clsids					= Z_MINCER,Z_GALANT,ZS_BFUZZ,ZS_MBALD,ZS_GALAN,ZS_MINCE

idle_sound_delay				= 80000
eat_sound_delay					= 4000
attack_sound_delay				= 8000

distant_idle_sound_delay		= 80000
distant_idle_sound_range		= 100.0

SoundThreshold					= 0.06					;range [0..1]
max_hear_dist					= 50

;------------------------------------------------------------------------------
; Vision
;------------------------------------------------------------------------------
eye_fov							= 110
eye_range						= 30

DynamicObjectsCount				= 32					;количество видимых объектов, с которыми может справиться монстр

min_view_distance				= 0.7					;коэффициент, который множится на eye_range, в зависимости от угла
max_view_distance				= 1.0					;коэффициент, который множится на eye_range, в зависимости от угла
visibility_threshold			= 100.0					;значение, при достижении суммой которого объект считается видимым
always_visible_distance			= 0.4
time_quant						= 0.001
decrease_value					= 0.01					;значение, на которое уменьшается вес, если объект попал в фрустум, но отсёкся по каким-то причинам
velocity_factor					= 0.5
luminocity_factor				= 0.5 					;фактор освещения (только для Актёра)
transparency_threshold			= 0.25



DamagedThreshold		= 0.4
critical_wound_threshold		= -1
critical_wound_decrease_quant	= 0.

material				= creatures\medium

LegsCount				= 2

step_params				= m_tushkano_step_params
damage					= m_tushkano_damage



[m_tushkano_attack_params]
;---------------------------------------------------------------------------------------------------------------------------------------------
;	anim			| time[0..1] | hit_power | impulse | impulse_dir (x,y,z)  |	Field of hit_test  (left,right, bottom, top ) |	Test Dist
;---------------------------------------------------------------------------------------------------------------------------------------------
stand_attack_0 =	  	0.25,		0.05,		    20,        0.0, 1.0, 0.0,		 -1.2, 1.2, -1.6, 1.6,							  1.0
stand_attack_1 =	  	0.25,		0.05,		    30,        0.0, 1.0, 0.0,		 -1.2, 1.2, -1.6, 1.6,							  1.0
stand_attack_2 =	  	0.25,		0.05,		    35,        0.0, 1.0, 0.0,		 -1.2, 1.2, -1.6, 1.6,							  1.0

[m_tushkano_step_params]
;---------------------------------------------------------------------------
;	anim			| Cycles | time1 | power1 | time2 | power2 |
;---------------------------------------------------------------------------
stand_walk_fwd_0 	=	1,	   0.2,     0.5,     0.7,    1,   
stand_run_0	 		=	1,	   0.25,     1,	    0.25,    1,    

;===========================================================================
; IMMUNITIES
;===========================================================================
[tushkano_immunities]
burn_immunity			= 1			;коэффициенты иммунитета 
strike_immunity			= 1
shock_immunity			= 1
wound_immunity			= 0.5
radiation_immunity		= 0.0
telepatic_immunity		= 1.0
chemical_burn_immunity	= 1
explosion_immunity		= 1
fire_wound_immunity		= 1

[m_tushkano_damage]
;bone_name		 = <hit_scale>,-1,<wound_scale>
;<hit_scale>	- коэфф. изменения хита (уменьшения здоровья) 
;<wound_scale>	- коэфф. изменения величины открытой раны

default				= 1.0, -1, 0.3

bip01_pelvis 		= 1.0, -1, 0.5
bip01_spine 		= 1.0, -1, 0.5
bip01_spine1 		= 1.0, -1, 0.5
bip01_neck 			= 1.0, -1, 1.5
bip01_head 			= 2.0, -1, 0.5, 10

[tushkan_terrain]
	255,000,255,255
	

