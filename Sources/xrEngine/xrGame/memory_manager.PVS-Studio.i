	fVector3			normal;
	fVector3			v;
	fVector3			v1;
	fVector3			P;
	Fplane				PL; 

	DUP.set				(0.0f,1.0f,0.0f);
	pvDecompress		(normal,vertex.plane());
	vertex_position		(P,vertex.position());
	PL.build			(P,normal);
	v.set				(X,P.y,Z);	
	PL.intersectRayPoint(v,DUP,v1);	
	return				(v1.y);
}

