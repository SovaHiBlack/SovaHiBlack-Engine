template <class T> class CSingleton {
private:
	static T*	_self;
	static int	_refcount;
public:	
	
	
	
	static bool _on_self_delete;
public:
					CSingleton			()	{}
	virtual			~CSingleton			()	{_self=0;}
	
	static			void DestroySingleton	()	{
		if(!_self) return;
		Log			("DestroySingleton::RefCounter:",_refcount);
		do {static bool ignore_always = false; if (!ignore_always && !(_on_self_delete == false)) ::Debug.fail("_on_self_delete == false","D:\\SovaHiBlack-Engine\\Sources\\xrEngine\\xrGame\\shared_data.h",20, __FUNCTION__  ,ignore_always);} while(0); 
