inline CLevelGraph::ELineIntersections  CLevelGraph::intersect( 
					   float x1, float y1,		
					   float x2, float y2,
					   float x3, float y3,		
					   float x4, float y4,
					   float *x, float *y      
		) const
{
	float a1, a2, b1, b2, c1, c2;	
	float r1, r2, r3, r4;			
	float denom, num;				

	



	a1 = y2 - y1;
	b1 = x1 - x2;
	c1 = x2 * y1 - x1 * y2;

	


	r3 = a1 * x3 + b1 * y3 + c1;
	r4 = a1 * x4 + b1 * y4 + c1;

	



	if ((r3*r4 > EPS) && !fis_zero(r3, EPS_3) && !fis_zero(r4, EPS_3))     return (eLineIntersectionNone);

	

	a2 = y4 - y3;
	b2 = x3 - x4;
	c2 = x4 * y3 - x3 * y4;

	

	r1 = a2 * x1 + b2 * y1 + c2;
	r2 = a2 * x2 + b2 * y2 + c2;

	




	if ((r1*r2 > EPS) && !fis_zero(r1, EPS_3) && !fis_zero(r2, EPS_3))     return (eLineIntersectionNone);

	
	if (fis_zero(r1*r2) && fis_zero(r3*r4)) return eLineIntersectionEqual;

	


	denom = a1 * b2 - a2 * b1;
	if (fis_zero(denom)) return (eLineIntersectionCollinear);

	num = b1 * c2 - b2 * c1;
	*x = num / denom;

	num = a2 * c1 - a1 * c2;
	*y = num / denom;

	return (eLineIntersectionIntersect);
} 

inline CLevelGraph::ELineIntersections  CLevelGraph::intersect_no_check( 
					   float x1, float y1,		
					   float x2, float y2,
					   float x3, float y3,		
					   float x4, float y4,
					   float *x, float *y      
		) const
{
	float		a1, a2, b1, b2, c1, c2;	
	float		r1, r2, r3, r4;			
	float		denom, num;				

	



	a1			= y2 - y1;
	b1			= x1 - x2;
	c1			= x2 * y1 - x1 * y2;

	


	r3			= a1 * x3 + b1 * y3 + c1;
	r4			= a1 * x4 + b1 * y4 + c1;

	



	

	a2			= y4 - y3;
	b2			= x3 - x4;
	c2			= x4 * y3 - x3 * y4;

	

	r1			= a2 * x1 + b2 * y1 + c2;
	r2			= a2 * x2 + b2 * y2 + c2;

	




	
	if (fis_zero(r1*r2) && fis_zero(r3*r4)) {
		*x		= x4;
		*y		= y4;
		return	(eLineIntersectionEqual);
	}

	


	denom = a1 * b2 - a2 * b1;
	if (fis_zero(denom)) {
		*x		= x4;
		*y		= y4;
		return	(eLineIntersectionEqual);
	}

	num			= b1 * c2 - b2 * c1;
	*x			= num / denom;

	num			= a2 * c1 - a1 * c2;
	*y			= num / denom;

	return		(eLineIntersectionIntersect);
} 

