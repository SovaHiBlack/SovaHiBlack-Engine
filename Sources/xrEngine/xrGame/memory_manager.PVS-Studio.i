}

inline	float CLevelGraph::vertex_cover(const CLevelGraph::CVertex *vertex) const
{
	float			_cover = 0.f;
	_cover			+= square((float(vertex->cover(0))/15.f),(float(vertex->cover(1))/15.f));
	_cover			+= square((float(vertex->cover(1))/15.f),(float(vertex->cover(2))/15.f));
	_cover			+= square((float(vertex->cover(2))/15.f),(float(vertex->cover(3))/15.f));
	_cover			+= square((float(vertex->cover(3))/15.f),(float(vertex->cover(0))/15.f));
	return			(_cover);
}

