	float		arg[4];

	inline float Calculate	(float t)
	{
		
		float x = (t+arg[2])*arg[3];
		return arg[0] + arg[1]*Func(x-floorf(x));
	}

	WaveForm()	{
		F		= fCONSTANT;
		arg[0]	= 0;
		arg[1]	= 1;
		arg[2]	= 0;
		arg[3]	= 1;
	}

	inline	BOOL	Similar	(const WaveForm& W) const
	{
		if (!fsimilar(arg[0],W.arg[0], EPS_3))	return 0;
