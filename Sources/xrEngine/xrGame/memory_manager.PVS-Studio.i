template < typename T>
void CObjectManager<T>::update					()
{
	float					result = (std::numeric_limits<float>::max());
	m_selected				= 0;
	OBJECTS::const_iterator	I = m_objects.begin();
	OBJECTS::const_iterator	E = m_objects.end();
	for ( ; I != E; ++I) {
		float				value = do_evaluate(*I);
		if (result > value) {
			result			= value;
			m_selected		= *I;
		}
	}
}

